# 이 파일은 견본입니다. 실제 값은 같은 폴더의 .env 파일에 넣으세요. (.env는 GitHub에 올라가지 않습니다)
# Supabase > Connect > Session pooler 연결 주소. [YOUR-PASSWORD] 자리에 DB 비밀번호를 넣으세요.
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# (선택) 이 컴퓨터처럼 SSL 검사를 하는 네트워크에서만 1
DC_INSECURE_SSL=0
